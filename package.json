{
  "name": "kharcha",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "npm run dev --prefix apps/api",
    "build": "npm run build --prefix packages/shared && npm run build --prefix apps/web && npm run build --prefix apps/api",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "nodemon": "^3.1.14"
  }
}
