{
  "installCommand": "npm install && npm run bundle:vercel -w api",
  "buildCommand": "npm run vercel-build -w apps/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
